# Runtime mode. Development defaults to the in-process repository; production
# rejects it and requires PostgreSQL.
FRAMEFACTORY_ENV=development
FRAMEFACTORY_REPOSITORY_BACKEND=memory

# PostgreSQL (required when repository backend is postgresql)
FRAMEFACTORY_DATABASE_URL=postgresql://framefactory:framefactory-local-only@localhost:5432/framefactory
FRAMEFACTORY_POSTGRES_POOL_MIN_SIZE=1
FRAMEFACTORY_POSTGRES_POOL_MAX_SIZE=10

# Redis queue (optional in development)
FRAMEFACTORY_REDIS_ENABLED=false
FRAMEFACTORY_REDIS_URL=redis://localhost:6379/0
FRAMEFACTORY_REDIS_NAMESPACE=framefactory
FRAMEFACTORY_REDIS_SOCKET_TIMEOUT_SECONDS=5

# S3 / Cloudflare R2 / MinIO object storage (optional in development)
FRAMEFACTORY_OBJECT_STORAGE_ENABLED=false
FRAMEFACTORY_S3_BUCKET=framefactory
FRAMEFACTORY_S3_REGION=us-east-1
FRAMEFACTORY_S3_ENDPOINT_URL=http://localhost:9000
FRAMEFACTORY_S3_ACCESS_KEY_ID=framefactory
FRAMEFACTORY_S3_SECRET_ACCESS_KEY=framefactory-local-only
FRAMEFACTORY_S3_ADDRESSING_STYLE=path
FRAMEFACTORY_S3_VERIFY_TLS=false
FRAMEFACTORY_S3_SIGNED_URL_TTL_SECONDS=900
FRAMEFACTORY_S3_CREATE_BUCKET=true

# Single-workspace installation identity. Replace these in production.
# FRAMEFACTORY_DEFAULT_USER_ID=00000000-0000-0000-0000-000000000000
# FRAMEFACTORY_DEFAULT_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
FRAMEFACTORY_DEFAULT_WORKSPACE_NAME=My Vistora
FRAMEFACTORY_DEFAULT_USER_EMAIL=owner@example.com
FRAMEFACTORY_DEFAULT_USER_DISPLAY_NAME=Vistora Owner

# Browser access
FRAMEFACTORY_CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
