  "worker": {
    "required_tokens": [
      "a.status='ready'", "af.scan_status='clean'", "aa.status='completed'",
      "a.copyright_status IN ('owned','licensed','public_domain')",
      "blocking_reason", "action_required"
    ]
  },
  "web": {
    "required_tokens": [
      "listAssets", "reviewAsset", "bulkUpdateAssets", "deleteAsset",
      "status-transitions", "batch-review", "batch-tags", "batch-reanalyze",
      "downloads/preview", "quarantined"
    ]
  }
