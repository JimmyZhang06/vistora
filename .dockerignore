.git
.gitignore
.dockerignore

# Local data, legacy runtime state, and user-owned media
var
src/runs
src/material-library
src/accounts/*/library
src/accounts/*/flywheel
src/data/jobs
src/data/flywheel/*
!src/data/flywheel/schema.sql
src/asset_scraper/_raw
src/.trash

# Private research inputs are mounted only in non-production workflows
src/_corpus
src/ip-skills/**/_research

# Secrets and credentials. Empty examples remain available to developers.
**/.env
**/.env.*
!**/.env.example
**/*_cookies.txt
deploy/config.json
src/agent/blockchain/config.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx

# Test/build output and offline delivery material
test-results
**/test-results
playwright-report
coverage
htmlcov
vendor
FrameFactory_Handoff_Package
FrameFactory_Handoff_Package.zip
docs
tools
.claude
src/docs
/src
/*.md
/*.html
/*.pdf
/*.docx
/*.ps1
/*.py
/src/*.md
/src/*.html
/src/*.pdf
src/frontend/test
src/frontend/verify
src/frontend/public
src/frontend/dist
**/node_modules
**/__pycache__
**/*.pyc
**/*.pyo
**/*.log

# Media is runtime/object-store data, except small code-owned image assets.
**/*.mp4
**/*.mov
**/*.mkv
**/*.webm
**/*.avi
**/*.flv
**/*.mp3
**/*.wav
**/*.m4a
**/*.aac
**/*.flac
/*.zip
/*.7z
/*.rar
/*.tar
/*.tar.gz
/*.tgz
