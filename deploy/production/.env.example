FF_API_PORT=8080
FF_S3_BUCKET=framefactory-production
FF_S3_REGION=us-east-1
# Public HTTPS S3/MinIO reverse-proxy origin used in API presigned URLs.
FF_S3_PUBLIC_ENDPOINT_URL=https://media.example.com
FF_DEFAULT_USER_ID=
FF_DEFAULT_WORKSPACE_ID=
FF_CORS_ALLOW_ORIGINS=
# Comma-separated runtime operations. This must cover both the normal DAG and:
# web.capture.validate, web.capture.screenshot, writing.compose.webpage,
# web.materialize, audio.synthesize, render.compose, quality.evaluate.
FF_WORKER_CAPABILITIES=
# Password files are consumed by PostgreSQL/Redis themselves.
FF_POSTGRES_PASSWORD_FILE=
FF_REDIS_PASSWORD_FILE=
# URL files are consumed by the API and must contain full connection URLs.
# Percent-encode reserved characters in embedded passwords.
FF_DATABASE_URL_FILE=
FF_REDIS_URL_FILE=
FF_S3_ACCESS_KEY_FILE=
FF_S3_SECRET_KEY_FILE=
FF_OPENAI_API_KEY_FILE=

# Structured-text provider used by writing.compose.webpage. Worker startup
# fails when an advertised operation resolves only to a placeholder.
FF_OPENAI_BASE_URL=https://api.example.com/v1
FF_OPENAI_RESEARCH_MODEL=
FF_OPENAI_WRITING_MODEL=
FF_OPENAI_QUALITY_MODEL=
FF_OPENAI_TIMEOUT_SECONDS=60
FF_LEGACY_MEDIA_ENABLED=true

# Separate least-privilege credentials for the browser sandbox. Never point
# these at the normal Worker database/Redis URL or MinIO root credentials.
FF_CAPTURE_DATABASE_URL_FILE=
FF_CAPTURE_REDIS_URL_FILE=
FF_CAPTURE_S3_ACCESS_KEY_FILE=
FF_CAPTURE_S3_SECRET_KEY_FILE=

# Dedicated browser-capture Worker. Deployment remains fail-closed until the
# proxy/firewall actually denies private, loopback, link-local and cloud
# metadata destinations at connection time, then this assertion is set true.
FF_BROWSER_EGRESS_PROXY_URL=
FF_BROWSER_EGRESS_POLICY_ENFORCED=false
FF_BROWSER_WORKER_CONCURRENCY=1
FF_BROWSER_NAVIGATION_TIMEOUT_SECONDS=20
FF_BROWSER_SETTLE_TIMEOUT_SECONDS=30
FF_BROWSER_SCREENSHOT_TIMEOUT_SECONDS=10
FF_BROWSER_JOB_TIMEOUT_SECONDS=90
FF_BROWSER_MAXIMUM_RESOURCES=400
FF_BROWSER_MAXIMUM_TRANSFER_BYTES=104857600
FF_BROWSER_MAXIMUM_BODY_CHARACTERS=12000
FF_BROWSER_MAXIMUM_REDIRECTS=5
