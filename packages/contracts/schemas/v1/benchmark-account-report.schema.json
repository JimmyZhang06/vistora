{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.framefactory.dev/v1/benchmark-account-report.schema.json",
  "title": "BenchmarkAccountReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "snapshot", "account_report", "note_reports"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/ContractVersion" },
    "generated_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "history_record_id": { "$ref": "common.schema.json#/$defs/NullableUuid" },
    "history_warning": { "type": ["string", "null"] },
    "snapshot": { "$ref": "benchmark-account-snapshot.schema.json" },
    "account_report": { "$ref": "#/$defs/AccountReport" },
    "note_reports": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/NoteReport" }
    }
  },
  "$defs": {
    "StrategySignal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "evidence", "likely_effect", "reusable_move"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 80 },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "evidence": { "type": "string", "minLength": 1, "maxLength": 500 },
        "likely_effect": { "type": "string", "minLength": 1, "maxLength": 500 },
        "reusable_move": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "Insight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "confidence", "claim", "evidence"],
      "properties": {
        "level": { "type": "string", "enum": ["observed", "derived", "inference", "limitation"] },
        "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
        "claim": { "type": "string", "minLength": 1, "maxLength": 500 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "Performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "percentile", "relative_to_median", "sample_median_likes_lower_bound", "caveat"],
      "properties": {
        "tier": { "type": "string", "enum": ["top_candidate", "above_baseline", "baseline", "below_baseline", "unknown"] },
        "percentile": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "relative_to_median": { "type": ["number", "null"], "minimum": 0 },
        "sample_median_likes_lower_bound": { "type": ["integer", "null"], "minimum": 0 },
        "caveat": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "NoteReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_index", "title", "format", "published_at", "likes_display",
        "likes_lower_bound", "performance", "strategy_signals", "viral_mechanisms",
        "recommendations", "evidence_depth", "limitations"
      ],
      "properties": {
        "sample_index": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "format": { "type": "string", "enum": ["video", "image", "unknown"] },
        "published_at": { "$ref": "common.schema.json#/$defs/NullableTimestamp" },
        "likes_display": { "type": "string", "minLength": 1, "maxLength": 40 },
        "likes_lower_bound": { "type": ["integer", "null"], "minimum": 0 },
        "performance": { "$ref": "#/$defs/Performance" },
        "strategy_signals": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/StrategySignal" } },
        "viral_mechanisms": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/Insight" } },
        "recommendations": { "type": "array", "maxItems": 16, "items": { "type": "string", "maxLength": 500 } },
        "evidence_depth": { "const": "public_metadata_only" },
        "limitations": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "string", "maxLength": 500 } }
      }
    },
    "TitlePattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "matching_notes", "share_percent", "top_candidate_matches", "median_likes_lower_bound", "lift_vs_sample_median"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 80 },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "matching_notes": { "type": "integer", "minimum": 1, "maximum": 64 },
        "share_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "top_candidate_matches": { "type": "integer", "minimum": 0, "maximum": 64 },
        "median_likes_lower_bound": { "type": ["integer", "null"], "minimum": 0 },
        "lift_vs_sample_median": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "AccountReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nickname", "sample_size", "evidence_depth", "executive_summary", "format_strategy",
        "publishing_strategy", "title_patterns", "top_candidate_note_indexes", "playbook", "limitations"
      ],
      "properties": {
        "nickname": { "type": "string", "minLength": 1, "maxLength": 120 },
        "sample_size": { "type": "integer", "minimum": 0, "maximum": 64 },
        "evidence_depth": { "const": "public_metadata_only" },
        "executive_summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "format_strategy": { "type": "string", "minLength": 1, "maxLength": 500 },
        "publishing_strategy": { "type": "string", "minLength": 1, "maxLength": 500 },
        "title_patterns": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/TitlePattern" } },
        "top_candidate_note_indexes": { "type": "array", "maxItems": 64, "items": { "type": "integer", "minimum": 1 } },
        "playbook": { "type": "array", "maxItems": 16, "items": { "type": "string", "maxLength": 500 } },
        "limitations": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "string", "maxLength": 500 } }
      }
    }
  }
}
