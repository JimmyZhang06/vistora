{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.framefactory.dev/v1/benchmark-media-evidence.schema.json",
  "title": "BenchmarkMediaEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_kind", "source_label", "title", "duration_ms", "has_audio", "segments"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/ContractVersion" },
    "source_kind": { "type": "string", "enum": ["worker_asset_analysis", "synthetic_demo"] },
    "source_label": { "type": "string", "minLength": 1, "maxLength": 200 },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "duration_ms": { "type": "integer", "minimum": 1, "maximum": 3600000 },
    "width": { "type": ["integer", "null"], "minimum": 1, "maximum": 16384 },
    "height": { "type": ["integer", "null"], "minimum": 1, "maximum": 16384 },
    "has_audio": { "type": "boolean" },
    "speech_status": { "type": "string", "enum": ["present", "absent", "unknown"] },
    "speech_detection_method": { "type": ["string", "null"], "maxLength": 200 },
    "analysis_status": { "enum": ["complete", "partial", null] },
    "sampled_frames": { "type": "boolean" },
    "transcript_text": { "type": ["string", "null"], "maxLength": 100000 },
    "speech_duration_ms": { "type": ["integer", "null"], "minimum": 1, "maximum": 3600000 },
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": { "$ref": "#/$defs/Segment" }
    },
    "silences": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "array",
        "prefixItems": [
          { "type": "integer", "minimum": 0 },
          { "type": "integer", "minimum": 1 }
        ],
        "minItems": 2,
        "maxItems": 2
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "maxLength": 500 }
    }
  },
  "$defs": {
    "Segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_ms", "end_ms", "description"],
      "properties": {
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 1 },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "shot_type": { "type": ["string", "null"], "maxLength": 80 },
        "camera_motion": { "type": ["string", "null"], "maxLength": 80 },
        "visual_style": { "type": ["string", "null"], "maxLength": 120 },
        "transcript": { "type": "string", "maxLength": 4000 },
        "ocr_text": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 200 } },
        "audio_events": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 200 } },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "representative_frame_key": { "type": ["string", "null"], "maxLength": 500 }
      }
    }
  }
}
