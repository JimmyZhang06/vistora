{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.framefactory.dev/v1/skill.schema.json",
  "title": "Skill",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "workspace_id", "ownership_type", "publisher_type", "publisher_name",
    "name", "slug", "description", "visibility", "status", "current_version_id", "forked_from_skill_id",
    "created_by", "created_at", "updated_at"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/ContractVersion" },
    "id": { "$ref": "common.schema.json#/$defs/Uuid" },
    "workspace_id": { "$ref": "common.schema.json#/$defs/Uuid" },
    "ownership_type": { "$ref": "enums.schema.json#/$defs/OwnershipType" },
    "publisher_type": { "$ref": "enums.schema.json#/$defs/PublisherType" },
    "publisher_name": { "$ref": "common.schema.json#/$defs/Name" },
    "name": { "$ref": "common.schema.json#/$defs/Name" },
    "slug": { "$ref": "common.schema.json#/$defs/Slug" },
    "description": { "$ref": "common.schema.json#/$defs/Description" },
    "visibility": { "$ref": "enums.schema.json#/$defs/Visibility" },
    "status": { "$ref": "enums.schema.json#/$defs/SkillStatus" },
    "current_version_id": { "$ref": "common.schema.json#/$defs/NullableUuid" },
    "forked_from_skill_id": { "$ref": "common.schema.json#/$defs/NullableUuid" },
    "revision": { "type": "integer", "minimum": 1, "readOnly": true },
    "created_by": { "$ref": "common.schema.json#/$defs/Uuid" },
    "created_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "updated_at": { "$ref": "common.schema.json#/$defs/Timestamp" }
  },
  "allOf": [
    {
      "if": { "properties": { "ownership_type": { "const": "system" } }, "required": ["ownership_type"] },
      "then": { "properties": { "publisher_type": { "const": "system" } } },
      "else": { "properties": { "publisher_type": { "const": "user" } } }
    }
  ],
  "examples": [
    {
      "schema_version": "1.0.0",
      "id": "44444444-4444-4444-8444-444444444444",
      "workspace_id": "22222222-2222-4222-8222-222222222222",
      "ownership_type": "workspace",
      "publisher_type": "user",
      "publisher_name": "Example Studio",
      "name": "Explainer Short",
      "slug": "explainer-short",
      "description": "A reusable method for concise explainers.",
      "visibility": "workspace",
      "status": "active",
      "current_version_id": "55555555-5555-4555-8555-555555555555",
      "forked_from_skill_id": null,
      "created_by": "11111111-1111-4111-8111-111111111111",
      "created_at": "2026-08-14T01:00:00Z",
      "updated_at": "2026-08-14T01:00:00Z"
    }
  ]
}
