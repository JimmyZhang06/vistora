{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.framefactory.dev/v1/library-build-job-create.schema.json",
  "title": "LibraryBuildJobCreate",
  "type": "object",
  "additionalProperties": false,
  "required": ["library_id", "topic", "rights_confirmed"],
  "properties": {
    "library_id": { "$ref": "common.schema.json#/$defs/Uuid" },
    "topic": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "queries": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["youtube", "bilibili", "wikimedia"] },
      "default": ["wikimedia"]
    },
    "max_assets": { "type": "integer", "minimum": 1, "maximum": 6, "default": 6 },
    "copyright_status": {
      "type": "string",
      "enum": ["licensed", "public_domain"],
      "default": "public_domain"
    },
    "rights_confirmed": { "const": true }
  },
  "allOf": [
    {
      "if": {
        "properties": { "copyright_status": { "const": "public_domain" } }
      },
      "then": {
        "properties": {
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": { "const": "wikimedia" }
          }
        }
      }
    }
  ]
}
