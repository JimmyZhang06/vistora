{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.framefactory.dev/v1/channel.schema.json",
  "title": "Channel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "workspace_id", "ownership_type", "name", "slug", "description",
    "platform", "handle", "brand_profile", "platform_connection_id", "status", "revision",
    "default_composition", "created_by", "created_at", "updated_at"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/ContractVersion" },
    "id": { "$ref": "common.schema.json#/$defs/Uuid" },
    "workspace_id": { "$ref": "common.schema.json#/$defs/Uuid" },
    "ownership_type": { "$ref": "enums.schema.json#/$defs/OwnershipType" },
    "name": { "$ref": "common.schema.json#/$defs/Name" },
    "slug": { "$ref": "common.schema.json#/$defs/Slug" },
    "description": { "$ref": "common.schema.json#/$defs/Description" },
    "platform": { "type": ["string", "null"], "minLength": 1, "maxLength": 80 },
    "handle": { "type": ["string", "null"], "minLength": 1, "maxLength": 300 },
    "brand_profile": { "type": "object", "additionalProperties": true },
    "platform_connection_id": {
      "$ref": "common.schema.json#/$defs/NullableUuid",
      "description": "Reference to connection metadata and its external secret reference. Credentials are never stored on Channel."
    },
    "status": { "type": "string", "enum": ["active", "paused", "archived"] },
    "revision": { "type": "integer", "minimum": 1 },
    "default_composition": { "$ref": "#/$defs/DefaultComposition" },
    "created_by": { "$ref": "common.schema.json#/$defs/Uuid" },
    "created_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "updated_at": { "$ref": "common.schema.json#/$defs/Timestamp" }
  },
  "$defs": {
    "DefaultComposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_version_id", "pipeline_version_id", "asset_library_ids",
        "voice_profile_id", "render_preset_version_id"
      ],
      "properties": {
        "skill_version_id": { "$ref": "common.schema.json#/$defs/Uuid" },
        "pipeline_version_id": { "$ref": "common.schema.json#/$defs/Uuid" },
        "asset_library_ids": {
          "type": "array", "maxItems": 100, "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/Uuid" }
        },
        "voice_profile_id": { "$ref": "common.schema.json#/$defs/NullableUuid" },
        "render_preset_version_id": { "$ref": "common.schema.json#/$defs/NullableUuid" }
      }
    }
  },
  "examples": [
    {
      "schema_version": "1.0.0",
      "id": "33333333-3333-4333-8333-333333333333",
      "workspace_id": "22222222-2222-4222-8222-222222222222",
      "ownership_type": "workspace",
      "name": "Daily Ideas",
      "slug": "daily-ideas",
      "description": "A sample publishing channel.",
      "platform": "youtube",
      "handle": "@dailyideas",
      "brand_profile": { "tone": "clear", "primary_color": "#101828" },
      "platform_connection_id": null,
      "status": "active",
      "revision": 1,
      "default_composition": {
        "skill_version_id": "55555555-5555-4555-8555-555555555555",
        "pipeline_version_id": "88888888-8888-4888-8888-888888888888",
        "asset_library_ids": ["66666666-6666-4666-8666-666666666666"],
        "voice_profile_id": null,
        "render_preset_version_id": "77777777-7777-4777-8777-777777777777"
      },
      "created_by": "11111111-1111-4111-8111-111111111111",
      "created_at": "2026-08-14T01:00:00Z",
      "updated_at": "2026-08-14T01:00:00Z"
    }
  ]
}
