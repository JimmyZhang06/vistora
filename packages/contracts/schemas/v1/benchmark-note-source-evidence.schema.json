{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.framefactory.dev/v1/benchmark-note-source-evidence.schema.json",
  "title": "BenchmarkNoteSourceEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "platform", "profile_user_id", "note_id", "canonical_url",
    "captured_at", "acquisition_method", "title", "description", "likes", "collects",
    "comments", "media", "limitations"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/ContractVersion" },
    "platform": { "const": "xiaohongshu" },
    "profile_user_id": { "type": "string", "pattern": "^[0-9a-f]{24}$" },
    "note_id": { "type": "string", "pattern": "^[0-9a-f]{24}$" },
    "canonical_url": { "type": "string", "format": "uri", "maxLength": 300 },
    "captured_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "acquisition_method": { "const": "authenticated_managed_browser" },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "description": { "type": "string", "maxLength": 10000 },
    "likes": { "$ref": "benchmark-account-snapshot.schema.json#/$defs/Metric" },
    "collects": { "$ref": "benchmark-account-snapshot.schema.json#/$defs/Metric" },
    "comments": { "$ref": "benchmark-account-snapshot.schema.json#/$defs/Metric" },
    "media": { "$ref": "#/$defs/MediaProbe" },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "type": "string", "maxLength": 500 }
    }
  },
  "$defs": {
    "MediaProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "video_available", "image_count", "duration_ms", "width", "height",
        "trusted_media_origin"
      ],
      "properties": {
        "kind": { "type": "string", "enum": ["video", "image"] },
        "video_available": { "type": "boolean" },
        "image_count": { "type": "integer", "minimum": 0, "maximum": 100 },
        "duration_ms": { "type": ["integer", "null"], "minimum": 0, "maximum": 3600000 },
        "width": { "type": ["integer", "null"], "minimum": 0, "maximum": 16384 },
        "height": { "type": ["integer", "null"], "minimum": 0, "maximum": 16384 },
        "trusted_media_origin": { "type": "boolean" }
      }
    }
  }
}
