{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.framefactory.dev/v1/user.schema.json",
  "title": "User",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "email", "display_name", "status", "created_at", "updated_at"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/ContractVersion" },
    "id": { "$ref": "common.schema.json#/$defs/Uuid" },
    "email": { "type": "string", "format": "email", "maxLength": 320 },
    "display_name": { "$ref": "common.schema.json#/$defs/Name" },
    "status": { "$ref": "enums.schema.json#/$defs/UserStatus" },
    "created_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "updated_at": { "$ref": "common.schema.json#/$defs/Timestamp" }
  },
  "examples": [
    {
      "schema_version": "1.0.0",
      "id": "11111111-1111-4111-8111-111111111111",
      "email": "creator@example.com",
      "display_name": "Example Creator",
      "status": "active",
      "created_at": "2026-08-14T01:00:00Z",
      "updated_at": "2026-08-14T01:00:00Z"
    }
  ]
}
