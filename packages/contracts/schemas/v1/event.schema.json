{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.framefactory.dev/v1/event.schema.json",
  "title": "Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "workspace_id", "ownership_type", "run_id", "step_id", "sequence", "type",
    "occurred_at", "actor_type", "actor_id", "correlation_id", "causation_id", "payload"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/ContractVersion" },
    "id": { "$ref": "common.schema.json#/$defs/Uuid" },
    "workspace_id": { "$ref": "common.schema.json#/$defs/Uuid" },
    "ownership_type": { "$ref": "enums.schema.json#/$defs/OwnershipType" },
    "run_id": { "$ref": "common.schema.json#/$defs/Uuid" },
    "step_id": { "$ref": "common.schema.json#/$defs/NullableUuid" },
    "sequence": { "type": "integer", "minimum": 1 },
    "type": { "$ref": "enums.schema.json#/$defs/EventType" },
    "occurred_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "actor_type": { "type": "string", "enum": ["user", "worker", "system"] },
    "actor_id": { "type": ["string", "null"], "maxLength": 255 },
    "correlation_id": { "$ref": "common.schema.json#/$defs/Uuid" },
    "causation_id": { "$ref": "common.schema.json#/$defs/NullableUuid" },
    "payload": {
      "type": "object",
      "maxProperties": 100,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,63}$" },
      "additionalProperties": {
        "type": ["string", "number", "integer", "boolean", "null"]
      }
    }
  },
  "examples": [
    {
      "schema_version": "1.0.0",
      "id": "cccccccc-cccc-4ccc-8ccc-cccccccccccc",
      "workspace_id": "22222222-2222-4222-8222-222222222222",
      "ownership_type": "workspace",
      "run_id": "99999999-9999-4999-8999-999999999999",
      "step_id": null,
      "sequence": 1,
      "type": "run.created",
      "occurred_at": "2026-08-14T03:00:00Z",
      "actor_type": "user",
      "actor_id": "11111111-1111-4111-8111-111111111111",
      "correlation_id": "dddddddd-dddd-4ddd-8ddd-dddddddddddd",
      "causation_id": null,
      "payload": { "idempotent_replay": false }
    }
  ]
}
