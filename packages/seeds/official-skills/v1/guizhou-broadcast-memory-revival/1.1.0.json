      {"id": "no-false-historical-media", "category": "visual", "description": "不存在将生成画面、网页截图或无关素材表述为历史档案的情况。", "severity": "error", "action": "fail"},
      {"id": "cultural-context", "category": "safety", "description": "民族、方言、民俗和地方文化表达准确、尊重语境且避免猎奇化。", "severity": "warning", "action": "request_review"},
      {"id": "editorial-final-review", "category": "technical", "description": "脚本、镜头、字幕、原声、版权与播出规格均经过编辑终审。", "severity": "error", "action": "request_review"}
