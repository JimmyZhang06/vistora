  "writing_policy": {
    "language": "zh-CN",
    "target_duration_seconds": 180,
    "tone_tags": ["纪实", "克制", "地方文化", "跨年代对照"],
    "structure": [
      {"name": "证据驱动的今昔叙事", "purpose": "从一个可核验的当下问题切入，按时间组织历史影像、原声采访与变化证据，解释地方经验并回到今天。", "target_share": 1}
    ],
    "markdown_instructions": "先读取冻结素材库存摘要，再开展事实研究并写稿。优先使用运行绑定素材库中的节目原片、采访原声和官方档案。每个历史事实、直接引语、人物身份、地名、年代和因果判断都必须可追溯到研究 Artifact 或具体媒资片段；区分节目原述、后续研究和编辑推论。尊重贵州各民族文化语境，保留必要方言原声并提供准确字幕。不得用生成画面冒充历史档案，不得为了戏剧性拼接出原素材不支持的因果关系。脚本 Beat 素材不足时才进入补采，补采失败则明确请求编辑补充，不以无来源内容补齐。",
    "prohibited_content": ["虚构史料、采访或直接引语", "用生成画面冒充历史档案", "篡改原采访语义或制造虚假因果", "无授权使用受限素材", "对民族文化作猎奇化或刻板化表达", "未标明来源的争议性历史结论"]
  },
  "visual_policy": {
    "aspect_ratio": "16:9",
    "frame_rate": 25,
    "visual_tags": ["广电纪实", "档案质感", "今昔对照", "原声优先"],
    "shot_duration_seconds": {"minimum": 2, "target": 6, "maximum": 12},
    "text_safe_area_percent": 10,
    "generated_media_allowed": false
  },
  "asset_policy": {
    "library_binding": "run_composition",
    "allowed_kinds": ["image", "video", "audio", "document"],
