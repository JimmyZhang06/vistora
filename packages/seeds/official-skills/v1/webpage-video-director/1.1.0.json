    "title": "多页面网页视频内部运行输入",
    "description": "由网页视频专用控制面创建；页面范围和镜头板必须分别经人工审核。",
    "properties": {
      "target_url": {"type": "string", "title": "规范化目标 URL", "format": "uri", "minLength": 9, "maxLength": 2048},
      "requested_url": {"type": "string", "title": "用户请求 URL", "format": "uri", "minLength": 9, "maxLength": 2048},
      "topic": {"type": "string", "title": "视频主题", "minLength": 1, "maxLength": 1600},
      "aspect_ratio": {"type": "string", "title": "画幅", "enum": ["16:9", "9:16", "1:1", "4:3"]},
      "duration_seconds": {"type": "integer", "title": "目标时长", "enum": [15, 30, 45, 60]},
      "subtitles_enabled": {"type": "boolean", "title": "启用字幕"},
      "voice_profile_id": {"type": "string", "title": "配音配置 ID", "minLength": 1, "maxLength": 255},
      "public_page_confirmed": {"type": "boolean", "title": "确认公开页面", "enum": [true]},
      "rights_confirmed": {"type": "boolean", "title": "确认有权使用", "enum": [true]},
      "webpage_video_run_id": {"type": "string", "title": "网页视频 Run ID", "minLength": 36, "maxLength": 36},
      "max_pages": {"type": "integer", "title": "最多页面数", "minimum": 1, "maximum": 12},
      "max_depth": {"type": "integer", "title": "链接发现深度", "minimum": 0, "maximum": 2},
      "same_origin_only": {"type": "boolean", "title": "仅同源页面", "enum": [true]},
      "include_sitemap": {"type": "boolean", "title": "读取 Sitemap"}
    },
    "required": [
      "target_url", "requested_url", "topic", "aspect_ratio", "duration_seconds",
      "subtitles_enabled", "public_page_confirmed", "rights_confirmed",
      "webpage_video_run_id", "max_pages", "max_depth", "same_origin_only", "include_sitemap"
    ],
    "additionalProperties": false
  },
  "research_policy": {
    "mode": "disabled",
    "allowed_source_types": ["user_provided"],
