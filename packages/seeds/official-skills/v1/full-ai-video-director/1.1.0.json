  "input_schema": {
    "type": "object",
    "title": "全 AI 影片内部运行输入",
    "description": "由 Full-AI typed endpoint 创建；不接受素材库或远程素材参数。",
    "properties": {
      "topic": {
        "type": "string",
        "title": "主题",
        "minLength": 1,
        "maxLength": 1600
      },
      "brief": {
        "type": "string",
        "title": "创意简报",
        "minLength": 1,
        "maxLength": 1600
      },
      "direction": {
        "type": "string",
        "title": "导演风格",
        "enum": [
          "cinematic",
          "graphic",
          "illustrated"
        ]
      },
      "aspect_ratio": {
        "type": "string",
        "title": "画幅",
        "enum": [
          "9:16",
          "16:9"
        ]
      },
      "duration_seconds": {
        "type": "integer",
        "title": "目标时长",
        "enum": [
          15,
          30,
          45,
          60
        ]
      },
      "variants_per_scene": {
        "type": "integer",
        "title": "每镜头候选",
        "minimum": 1,
        "maximum": 3
      },
      "continuity": {
        "type": "boolean",
        "title": "连续性提示包"
      },
      "ai_disclosure": {
        "type": "boolean",
        "title": "AI 内容声明"
      },
      "visual_source_mode": {
        "type": "string",
        "title": "视觉来源",
        "enum": [
          "generated_only"
        ]
      },
      "full_ai_run_id": {
        "type": "string",
        "title": "Full-AI Run ID"
      },
      "scene_count": {
        "type": "integer",
        "title": "冻结镜头数",
        "minimum": 1,
        "maximum": 12
      },
      "candidate_count": {
        "type": "integer",
        "title": "冻结候选数",
        "minimum": 1,
        "maximum": 36
      },
      "billable_seconds": {
        "type": "integer",
        "title": "冻结计费秒数",
        "minimum": 5,
        "maximum": 180
      },
      "max_cost_minor": {
        "type": "integer",
        "title": "授权成本上限",
        "minimum": 0
      }
    },
    "required": [
      "topic",
      "brief",
      "direction",
      "aspect_ratio",
      "duration_seconds",
      "variants_per_scene",
      "continuity",
      "ai_disclosure",
      "visual_source_mode",
      "full_ai_run_id",
      "scene_count",
      "candidate_count",
      "billable_seconds",
      "max_cost_minor"
    ],
    "additionalProperties": false
  },
  "research_policy": {
    "mode": "disabled",
    "allowed_source_types": [
      "primary",
      "official",
      "academic",
      "news",
      "user_provided"
    ],
    "require_https": true,
    "fact_treatment": "cite",
    "citation_style": "artifact_only",
    "minimum_sources": 0,
    "maximum_sources": 5,
    "freshness_days": 365,
    "blocked_domains": []
  },
  "writing_policy": {
    "language": "zh-CN",
    "target_duration_seconds": 30,
    "tone_tags": [
      "电影化",
      "连续",
      "可生成"
    ],
    "structure": [
      {
        "name": "连续分镜叙事",
        "purpose": "把简报转成旁白与一组连续、可独立生成的镜头 Beats。",
        "target_share": 1
      }
    ],
    "markdown_instructions": "这是创意影片而非事实报道。严格读取运行快照中的 scene_count，并输出恰好 scene_count 个有序 Beat；每个 Beat 的视觉预算不得超过 clip_seconds=5 秒。每个 Beat 给出主体、动作、环境、摄影、光线、must_match、must_not_match 与 continuity anchors。不得增加 Beat 或候选数量；需要更多画面时必须在首次付费生成前以 FULL_AI_PLAN_DRIFT 失败。",
    "prohibited_content": [
      "把虚构内容伪装成事实",
      "未经授权模仿真人或受保护角色",
      "绕过生成安全策略",
      "超出冻结镜头数或预算"
    ]
  },
  "visual_policy": {
    "aspect_ratio": "9:16",
    "frame_rate": 30,
    "visual_tags": [
      "generated-only",
      "连续性提示包",
      "电影化"
    ],
    "shot_duration_seconds": {
      "minimum": 2,
      "target": 5,
      "maximum": 5
    },
    "text_safe_area_percent": 10,
    "generated_media_allowed": true
  },
  "asset_policy": {
    "library_binding": "none",
    "allowed_kinds": [
      "image",
      "video"
    ],
    "minimum_assets": 0,
    "license_required": false,
    "fallback": "generated",
    "deduplicate_by_hash": true
  },
  "qc_policy": {
    "rules": [
      {
        "id": "generated-audit-complete",
        "category": "technical",
        "description": "每个生成候选都有 Provider task、提示词、模型、条款和价格快照及内容哈希。",
        "severity": "error",
        "action": "fail"
      },
      {
        "id": "plan-budget-frozen",
        "category": "technical",
        "description": "镜头、候选、计费秒数和成本不超过创建时冻结计划。",
        "severity": "error",
        "action": "fail"
      },
      {
        "id": "generated-safety",
        "category": "safety",
        "description": "所有生成候选通过 Provider 与本地安全检查。",
        "severity": "error",
        "action": "fail"
      },
      {
        "id": "timing-frozen",
        "category": "technical",
        "description": "EDL 只消费真实旁白时序与冻结 CandidateManifest。",
        "severity": "error",
        "action": "fail"
      }
    ],
    "human_review": "on_warning",
    "minimum_pass_rate": 1
  },
