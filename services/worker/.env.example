FRAMEFACTORY_ENV=development
FRAMEFACTORY_DATABASE_URL=postgresql://framefactory:change-me@127.0.0.1:5432/framefactory
FRAMEFACTORY_REDIS_URL=redis://127.0.0.1:6379/0
FRAMEFACTORY_REDIS_NAMESPACE=framefactory
FRAMEFACTORY_WORKER_CONCURRENCY=2
FRAMEFACTORY_RUN_QUEUE=runs
FRAMEFACTORY_STEP_QUEUE=run-steps
FRAMEFACTORY_WORKER_LEASE_SECONDS=30
FRAMEFACTORY_WORKER_POLL_SECONDS=0.5
FRAMEFACTORY_WORKER_RECOVERY_SECONDS=15

# Durable v3 scene-level asset catalog. It only returns assets that passed
# safety review and have owned/licensed/public-domain rights.
FRAMEFACTORY_ASSET_LIBRARY_ENABLED=true
FRAMEFACTORY_ASSET_MINIMUM_SIMILARITY=0.35
FRAMEFACTORY_ASSET_MAXIMUM_ASSETS=12
FRAMEFACTORY_CONTROL_API_URL=http://127.0.0.1:8200
FRAMEFACTORY_ASSET_ACQUISITION_TIMEOUT_SECONDS=600
FRAMEFACTORY_ASSET_ANALYSIS_QUEUE=asset-analysis
FRAMEFACTORY_ASSET_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
FRAMEFACTORY_ASSET_VISION_API_KEY_FILE=/run/secrets/framefactory_asset_vision_api_key
FRAMEFACTORY_ASSET_VISION_MODEL=qwen-vl-max
FRAMEFACTORY_ASSET_VISION_TIMEOUT_SECONDS=180
FRAMEFACTORY_ASSET_ANALYSIS_RATE_PER_MINUTE=30
FRAMEFACTORY_ASSET_ANALYSIS_AUTO_READY=true

# Optional OpenAI-compatible ASR. When omitted, embedded subtitles and silence
# still improve cuts; voiced assets remain review-required until ASR is configured.
FRAMEFACTORY_ASR_BASE_URL=https://api.example.com/v1
FRAMEFACTORY_ASR_API_KEY_FILE=/run/secrets/framefactory_asr_api_key
FRAMEFACTORY_ASR_MODEL=transcription-model
FRAMEFACTORY_ASR_TIMEOUT_SECONDS=600
# Use verbose_json + word for precise safe cuts. Text-only providers must use
# json + none; their transcript improves search but cannot authorize a cut.
FRAMEFACTORY_ASR_RESPONSE_FORMAT=verbose_json
FRAMEFACTORY_ASR_TIMESTAMP_MODE=word

# Optional vendor-neutral structured text provider. All three models and durable
# object storage are required together; secrets must come from the environment.
FRAMEFACTORY_OPENAI_BASE_URL=https://api.example.com/v1
FRAMEFACTORY_OPENAI_API_KEY_FILE=/run/secrets/framefactory_openai_api_key
FRAMEFACTORY_OPENAI_RESEARCH_MODEL=research-model
FRAMEFACTORY_OPENAI_WRITING_MODEL=writing-model
FRAMEFACTORY_OPENAI_QUALITY_MODEL=quality-model
FRAMEFACTORY_OPENAI_TIMEOUT_SECONDS=60

# Independent generated-only video providers. These settings never reuse the
# downloaded-asset analyzer or the shared media catalog. Full-AI readiness also
# requires durable S3, FFmpeg/FFprobe, and the generated writing/TTS operations.
FRAMEFACTORY_RUNWAY_BASE_URL=https://api.dev.runwayml.com
FRAMEFACTORY_RUNWAY_API_KEY_FILE=/run/secrets/framefactory_runway_api_key
FRAMEFACTORY_RUNWAY_MODEL=gen4.5
FRAMEFACTORY_RUNWAY_TIMEOUT_SECONDS=60
FRAMEFACTORY_FULL_AI_VISION_BASE_URL=https://api.example.com/v1
FRAMEFACTORY_FULL_AI_VISION_API_KEY_FILE=/run/secrets/framefactory_full_ai_vision_api_key
FRAMEFACTORY_FULL_AI_VISION_MODEL=vision-model
FRAMEFACTORY_FULL_AI_VISION_TIMEOUT_SECONDS=180

# Public immutable control-plane quote, terms, pricing and operator attestation.
# Provider/model must exactly match the Worker provider above.
FRAMEFACTORY_FULL_AI_PROVIDER_NAME=runway
FRAMEFACTORY_FULL_AI_MODEL_ID=gen4.5
FRAMEFACTORY_FULL_AI_COST_PER_SECOND_MINOR=12
FRAMEFACTORY_FULL_AI_CREDIT_UNIT_MINOR=1
FRAMEFACTORY_FULL_AI_TERMS_REFERENCE=https://example.invalid/immutable-terms-snapshot
FRAMEFACTORY_FULL_AI_TERMS_CONTENT_HASH=<64-lowercase-hex>
FRAMEFACTORY_FULL_AI_TERMS_CAPTURED_AT=2026-08-23T00:00:00Z
FRAMEFACTORY_FULL_AI_PRICING_REFERENCE=https://example.invalid/immutable-pricing-snapshot
FRAMEFACTORY_FULL_AI_PRICING_CONTENT_HASH=<64-lowercase-hex>
FRAMEFACTORY_FULL_AI_PRICING_CAPTURED_AT=2026-08-23T00:00:00Z
FRAMEFACTORY_FULL_AI_OUTPUT_RIGHTS_CONFIRMED=true
FRAMEFACTORY_FULL_AI_OUTPUT_RIGHTS_LICENSE_BASIS=operator-confirmed provider terms

# Optional vendor-neutral research search. The endpoint receives
# POST {"query": string, "limit": number} and returns
# {"results":[{"title":string,"url":https-url,"snippet":string}]}.
# Leave both URL and token unset when online research is unavailable.
FRAMEFACTORY_RESEARCH_SEARCH_URL=https://search.example.com/v1/search
FRAMEFACTORY_RESEARCH_SEARCH_BEARER_TOKEN_FILE=/run/secrets/framefactory_research_search_token
FRAMEFACTORY_RESEARCH_SEARCH_TIMEOUT_SECONDS=20
FRAMEFACTORY_RESEARCH_SEARCH_MAX_RESPONSE_BYTES=1048576

FRAMEFACTORY_S3_BUCKET=framefactory
FRAMEFACTORY_S3_REGION=auto
FRAMEFACTORY_S3_ENDPOINT_URL=https://objects.example.com
FRAMEFACTORY_S3_ACCESS_KEY_ID_FILE=/run/secrets/framefactory_s3_access_key_id
FRAMEFACTORY_S3_SECRET_ACCESS_KEY_FILE=/run/secrets/framefactory_s3_secret_access_key

# Optional local Edge TTS and FFmpeg bridge. Leave the catalog variables unset
# when FRAMEFACTORY_ASSET_LIBRARY_ENABLED=true; v1 JSON catalogs are not scanned.
FRAMEFACTORY_LEGACY_MEDIA_ENABLED=false
FRAMEFACTORY_LEGACY_TTS_VOICE=zh-CN-YunjianNeural
FRAMEFACTORY_LEGACY_TTS_RATE=+25%
FRAMEFACTORY_FFMPEG_COMMAND=ffmpeg
FRAMEFACTORY_FFPROBE_COMMAND=ffprobe
FRAMEFACTORY_LEGACY_RENDER_WIDTH=1080
FRAMEFACTORY_LEGACY_RENDER_HEIGHT=1920
FRAMEFACTORY_LEGACY_RENDER_FPS=30
FRAMEFACTORY_LEGACY_MAXIMUM_ASSETS=12

# Dedicated browser-capture process profile. Do not combine this profile with
# any OpenAI/Runway/legacy media/library/asset-analysis provider variables above.
# Production refuses to start unless the connection-time egress proxy/firewall
# policy is externally enforced and explicitly asserted.
FRAMEFACTORY_BROWSER_CAPTURE_ONLY=false
FRAMEFACTORY_BROWSER_CAPTURE_ENABLED=false
FRAMEFACTORY_BROWSER_EGRESS_PROXY_URL=https://egress-proxy.internal:3128
FRAMEFACTORY_BROWSER_EGRESS_POLICY_ENFORCED=false
FRAMEFACTORY_BROWSER_ALLOW_NON_STANDARD_PORTS=false
FRAMEFACTORY_BROWSER_NAVIGATION_TIMEOUT_SECONDS=20
FRAMEFACTORY_BROWSER_SETTLE_TIMEOUT_SECONDS=30
FRAMEFACTORY_BROWSER_SCREENSHOT_TIMEOUT_SECONDS=10
FRAMEFACTORY_BROWSER_JOB_TIMEOUT_SECONDS=90
FRAMEFACTORY_BROWSER_MAXIMUM_RESOURCES=400
FRAMEFACTORY_BROWSER_MAXIMUM_TRANSFER_BYTES=104857600
FRAMEFACTORY_BROWSER_MAXIMUM_BODY_CHARACTERS=12000
FRAMEFACTORY_BROWSER_MAXIMUM_REDIRECTS=5
