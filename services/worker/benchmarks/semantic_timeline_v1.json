{
  "schema_version": "1",
  "name": "FrameFactory domain-neutral semantic story baseline v1",
  "lessons": [
    {
      "issue_code": "COMPOUND_VISUAL_BEAT",
      "symptom": "一个分镜合并多个地点、动作或因果阶段，单个素材无法诚实覆盖。",
      "root_cause": "写作输出只有自由文本 scenes，没有原子 Beat 契约。",
      "fix": "写作输出按顺序提供结构化 Beat、对应旁白和 must/must-not 证据；兼容输入只按通用句法边界拆分。",
      "regression_tests": ["services/worker/tests/test_database_assets.py::test_structured_beats_define_atomic_visual_units_for_any_subject"]
    },
    {
      "issue_code": "SEMANTICALLY_WRONG_CUT",
      "symptom": "旁白已进入下一叙事节点，画面仍停留在上一节点。",
      "root_cause": "按句数均分或局部贪心选择压过了 Beat 与旁白的明确对应关系。",
      "fix": "使用 Run 冻结的 Beat-to-narration 提示和单调全局规划，禁止剧情路径倒退。",
      "regression_tests": ["services/worker/tests/test_legacy_media_adapters.py::test_timeline_plans_a_coherent_film_story_path"]
    },
    {
      "issue_code": "SOURCE_SEGMENT_OVERRUN",
      "symptom": "片段时长不足时读取后续原片，进入未选择的对白或场景。",
      "root_cause": "时间线把素材片段边界当作软提示。",
      "fix": "将入库片段 start/end 设为硬边界，不足只能显式 padding 或重新选片。",
      "regression_tests": ["services/worker/tests/test_legacy_media_adapters.py::test_timeline_never_reads_past_an_ingested_virtual_clip"]
    },
    {
      "issue_code": "MISSING_ASSET_STALL",
      "symptom": "素材不足时任务永久停在 media.select，下载完成后仍需人工重试。",
      "root_cause": "补采任务和素材分析没有 acquisition group 完成语义，也没有受限恢复预算。",
      "fix": "按缺失 Beat 建补采槽位，整组分析完成后幂等恢复；预算耗尽或仍不匹配才转人工。",
      "regression_tests": ["services/worker/tests/test_database_assets.py::test_second_acquisition_round_can_still_resume_without_a_human", "services/worker/tests/test_asset_service.py"]
    },
    {
      "issue_code": "UNSUPPORTED_FACTUAL_PRECISION",
      "symptom": "研究或旁白加入输入来源无法证明的日期、速度、温度或数量。",
      "root_cause": "生成模型在重写后仍可能重复未经支持的精确数字。",
      "fix": "研究和写作共享数量声明校验；重试后仍不合格则确定性改写为定性表达。",
      "regression_tests": ["services/worker/tests/test_provider_adapters.py::test_research_quantity_fallback_keeps_meaning_without_false_precision", "services/worker/tests/test_provider_adapters.py::test_script_quantity_fallback_removes_persistent_provider_precision"]
    }
  ],
